NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=theo123
DATABASE_NAME=fleet_db
DATABASE_SSL=false
DATABASE_SYNC=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=dev-access-secret-change-me-min-32-chars!!
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:3001,http://localhost:19006

# ---------------------------------------------------------------------------
# Google Maps Platform (paste keys from YOUR Google Cloud Console project)
# Free trial / billing must be enabled on the GCP project.
# See backend/docs/GOOGLE_MAPS_SETUP.md
# ---------------------------------------------------------------------------
# Server key — restrict by IP. Used for Geocoding + Routes + Distance Matrix.
GOOGLE_MAPS_API_KEY=
# Browser Maps JS key belongs in frontend/.env.local as NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
# (do NOT put the browser key here; do NOT put the server key in the frontend).

# Phone-first tracking (rider app GPS). Hardware GPS webhook is optional.
TRACKING_MODE=phone_primary
TRACKING_ROUTE_DEVIATION_METERS=120
TRACKING_ETA_GRACE_SECONDS=180
LOCATION_ACCURACY_THRESHOLD_M=80
MOVING_SPEED_THRESHOLD_MPS=1.5
STOPPED_SPEED_THRESHOLD_MPS=0.6
MIN_DISTANCE_INTERVAL_M=12
MAX_TELEPORT_SPEED_MPS=55
STOP_RADIUS_M=40
STOP_MIN_DURATION_SEC=180
MOVING_CONFIRM_SEC=8
STOPPED_CONFIRM_SEC=45
PRESENCE_LIVE_SEC=30
PRESENCE_DELAYED_SEC=90
PRESENCE_STALE_SEC=300
PRESENCE_OFFLINE_SEC=300
LOCATION_UPLOAD_BATCH_SIZE=50
REDIS_TRACKING_TTL_SEC=600
TRACKING_ROADS_SNAP_ENABLED=false
TRACKING_HISTORY_RETENTION_DAYS=365

# Optional integrations (MVP works without these)
# WhatsApp Cloud API — see backend/docs/WHATSAPP_AI_DISPATCH.md
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=dev-whatsapp-verify
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
OPENAI_API_KEY=
OPENAI_TRANSPORT_MODEL=gpt-4o
GEMINI_API_KEY=
AI_PROVIDER=openai
# Optional hardware GPS webhook auth (leave empty when relying on rider phones)
GPS_API_KEY=
AI_CONFIDENCE_THRESHOLD=0.75
# Minutes before requested pickup when changing pickup is still allowed
WHATSAPP_PICKUP_CHANGE_MINUTES_BEFORE=30

DISPATCH_OFFER_TIMEOUT_SECONDS=45
GPS_OFFLINE_THRESHOLD_SECONDS=120
LOCATION_LIVE_SECONDS=30
LOCATION_DELAYED_SECONDS=120
UNAUTHORIZED_MOVEMENT_DISTANCE_METERS=300
UNAUTHORIZED_MOVEMENT_DURATION_SECONDS=120
UNAUTHORIZED_MOVEMENT_MIN_ACCURACY_METERS=50
RIDER_SEARCH_RADIUS_METERS=10000
RIDER_LOCATION_MAX_AGE_SECONDS=60
ASSIGNMENT_CANDIDATE_LIMIT=10
ASSIGNMENT_MATRIX_FALLBACK=true

SWAGGER_ENABLED=true
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
WORKER_MODE=false
