NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=fleet
DATABASE_PASSWORD=fleet_secret
DATABASE_NAME=fleet_db
DATABASE_SSL=false
DATABASE_SYNC=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=dev-access-secret-change-me-min-32-chars!!
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:3001,http://localhost:19006

# Optional integrations (MVP works without these)
GOOGLE_MAPS_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=dev-whatsapp-verify
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=mock
GPS_API_KEY=
AI_CONFIDENCE_THRESHOLD=0.75

DISPATCH_OFFER_TIMEOUT_SECONDS=45
GPS_OFFLINE_THRESHOLD_SECONDS=120
LOCATION_LIVE_SECONDS=30
LOCATION_DELAYED_SECONDS=120
UNAUTHORIZED_MOVEMENT_DISTANCE_METERS=300
UNAUTHORIZED_MOVEMENT_DURATION_SECONDS=120
UNAUTHORIZED_MOVEMENT_MIN_ACCURACY_METERS=50
RIDER_SEARCH_RADIUS_METERS=10000

SWAGGER_ENABLED=true
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
WORKER_MODE=false
